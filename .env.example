# CIBUS Cebu Platform Environment Configuration
# NOTE: NO .env file is required to run or test this platform!
# By default, the platform boots with built-in Dry-Run Simulation Mode, pre-seeded Cebu CIBUS routes/stops/buses,
# and the built-in PayMongo Mock Sandbox (GCash, Maya, QR Ph, In-App Card, and Cash all enabled out-of-the-box).

# Server & Database (Optional overrides)
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cibus_cebu
JWT_SECRET=cibus-cebu-production-grade-secret-key-change-in-prod

# Payment Gateway Configuration (Built-in Mock Sandbox enabled by default without .env)
PAYMENT_PROVIDER_NAME=PayMongo_Mock_Sandbox
PAYMONGO_SECRET_KEY=sk_test_cibus_cebu_mock_sandbox_key
PAYMONGO_PUBLIC_KEY=pk_test_cibus_cebu_mock_sandbox_key
PAYMONGO_WEBHOOK_SECRET=whsec_cibus_sandbox_verification_secret

# Supported Payment Methods (All enabled by default unless explicitly set to 'false')
ENABLE_GCASH_SANDBOX=true
ENABLE_MAYA_SANDBOX=true
ENABLE_QRPH_SANDBOX=true
ENABLE_INAPP_CARD_SANDBOX=true


